APP_NAME="Surat Digital KUA"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://example.com

APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# MySQL untuk produksi
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=surdig
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Pengaturan email (SMTP Gmail). Untuk mengaktifkan pengiriman email sungguhan,
# isi MAIL_USERNAME, MAIL_PASSWORD (App Password: https://myaccount.google.com/apppasswords,
# aktifkan 2-Step Verification dulu) dan MAIL_FROM_ADDRESS.
# MAIL_SCHEME opsional; kosong = otomatis berdasarkan port (587 -> smtp, 465 -> smtps).
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Token rahasia untuk endpoint webhook deploy (/deploy)
DEPLOY_TOKEN=

# Kredensial seeder awal (opsional, kosongkan untuk memakai default staf@kua.local / kepala@kua.local, password "password")
STAFF_EMAIL=
STAFF_PASSWORD=
KEPALA_EMAIL=
KEPALA_PASSWORD=
